#!/usr/bin/env python
import cv2
import rospy
from sensor_msgs.msg import CompressedImage

class CameraNode:
    def __init__(self):
        rospy.init_node('camera', anonymous=False)

        # Get parameters from the ROS parameter server
        self.device = rospy.get_param('~device', 0)
        self.framerate = rospy.get_param('~framerate', 20.0)
        self.width = rospy.get_param('~width', 160)
        self.height = rospy.get_param('~height', 100)

        # Initialize the camera
        self.camera = cv2.VideoCapture(self.device)
        self.camera.set(cv2.CAP_PROP_FRAME_WIDTH, self.width)
        self.camera.set(cv2.CAP_PROP_FRAME_HEIGHT, self.height)

        # Create a publisher
        self.publisher = rospy.Publisher("~image", CompressedImage, queue_size=1)

        # Set up a timer for capturing and publishing images
        rospy.Timer(rospy.Duration.from_sec(1.0/self.framerate), self.publish_image)

        # Set up a shutdown hook
        rospy.on_shutdown(self.cleanup)

    def publish_image(self, timer_event):
        # Fetch the current image from the camera
        (grabbed, frame) = self.camera.read()

        if not grabbed:
            rospy.logwarn("Failed to grab frame from camera")
            return

        # Build message
        message = CompressedImage()
        message.data = cv2.imencode('.jpg', frame)[1].tostring()
        message.format = "jpeg"
        message.header.stamp = rospy.Time.now()

        # Publish new image to the topic
        self.publisher.publish(message)

    def cleanup(self):
        self.camera.release()
        cv2.destroyAllWindows()

    def run(self):
        rospy.spin()

if __name__ == '__main__':
    node = CameraNode()
    node.run()